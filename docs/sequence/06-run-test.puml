@startuml 06-run-test
title Correr un test de un snippet (US #9)
autonumber

actor "Usuario" as user
participant "UI" as ui
participant "nginx" as nginx
participant "Snippet Service" as snippet
participant "Permission Service" as perm
database "Snippet DB" as sdb
participant "Azure Blob Storage" as assets
participant "PrintScript Service" as runner

user -> ui : abre el snippet y elige "correr test"
ui -> nginx : POST /api/snippets/{id}/tests/{testId}/run (JWT)
nginx -> snippet : POST /snippets/{id}/tests/{testId}/run
snippet -> snippet : valida JWT y obtiene userId

snippet -> perm : GET /permissions/check?userId=&snippetId=
alt sin acceso
    perm --> snippet : 404
    snippet --> nginx : 404
    nginx --> ui : 404
    ui --> user : snippet no encontrado
else OWNER o READ
    perm --> snippet : OWNER / READ
    snippet -> sdb : obtiene el test (inputs, expectedOutputs) y la versión
    snippet -> assets : lee "snippets/{id}/original"
    snippet -> runner : POST /test { content, version, inputs, expectedOutputs }
    runner -> runner : ejecuta, entregando inputs en orden\ny capturando cada println
    runner --> snippet : 200 { passed, outputs, error }
    snippet -> sdb : guarda last_status, last_outputs, last_run_at
    snippet --> nginx : 200 { passed, outputs, error }
    nginx --> ui : 200
    ui --> user : muestra outputs y si pasó
end

note over ui, runner
  Para mostrar los outputs "a medida que se evalúan" (#9) y la
  ejecución interactiva (#10), la llamada se reemplaza más adelante
  por un WebSocket: /snippets/{id}/run.
end note

@enduml
