@startuml 01-create-snippet
title Crear snippet con validación (US #1, #3)
autonumber

actor "Usuario" as user
participant "UI" as ui
participant "nginx" as nginx
participant "Snippet Service" as snippet
participant "PrintScript Service" as runner
participant "Azure Blob Storage" as assets
database "Snippet DB" as sdb
participant "Permission Service" as perm
queue "Redis Streams" as redis

user -> ui : completa nombre, descripción, lenguaje, versión\ny sube archivo o escribe en el editor
ui -> nginx : POST /api/snippets (JWT)
nginx -> snippet : POST /snippets
snippet -> snippet : valida JWT y obtiene userId

snippet -> runner : POST /validate { content, version }

alt snippet inválido
    runner --> snippet : 422 { errors: [rule, line, column] }
    snippet --> nginx : 422 { errors }
    nginx --> ui : 422 { errors }
    ui --> user : muestra regla incumplida, línea y columna
else snippet válido
    runner --> snippet : 200 { valid: true }

    snippet -> snippet : genera id (UUID)
    snippet -> assets : sube "snippets/{id}/original"
    snippet -> sdb : INSERT snippet (lintStatus = PENDING, formatStatus = PENDING)
    snippet -> perm : POST /permissions { userId, snippetId, OWNER }

    alt falla la creación del permiso
        perm --> snippet : error
        snippet -> sdb : DELETE snippet
        snippet -> assets : borra "snippets/{id}/original"
        snippet --> nginx : 503
        nginx --> ui : 503
        ui --> user : informa que no se pudo crear
    else permiso creado
        perm --> snippet : 201

        snippet -> sdb : obtiene reglas de lint y formato del usuario
        snippet -> redis : XADD lint-requests { snippetId, revision, content, version, rules }
        snippet -> redis : XADD format-requests { snippetId, revision, content, version, rules }

        snippet --> nginx : 201 { snippet }
        nginx --> ui : 201 { snippet }
        ui --> user : muestra el snippet creado (lint pendiente)
    end
end

note over snippet, assets
  El contenido se sube antes del INSERT: si el INSERT falla,
  queda a lo sumo un blob huérfano, nunca una fila sin contenido.
end note

@enduml
